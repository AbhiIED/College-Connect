# ============================================================
# CollegeConnect Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ── Server Config ────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
APP_NAME="CollegeConnect"

# ── Database Config ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=CollegeConnect
DB_SSL=false

# ── JWT Authentication ───────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_change_in_production

# ── Razorpay Config (for Alumni donations) ───────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── Email / SMTP Config (for OTP Verification & Password Reset)
# Option A: Simple Gmail Setup (Leave SMTP_HOST blank to auto-use Gmail)
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password

# Option B: Custom SMTP Settings (e.g. Brevo, AWS SES, SendGrid)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CollegeConnect" <noreply@yourdomain.com>
