# Database Config
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=AlumniSphere
DB_PORT=3306

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production

# Razorpay Config (for Alumni donations)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email / SMTP Config (for OTP Verification & Password Reset)
# Option A: Simple Gmail Setup (Leave host/port/secure blank to auto-use Gmail settings)
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password

# Option B: Custom SMTP Settings (e.g. AWS SES, Mailgun, SendGrid)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CollegeConnect" <noreply@yourdomain.com>

# Server Config
PORT=5000
FRONTEND_URL=http://localhost:5173
APP_NAME="CollegeConnect"
